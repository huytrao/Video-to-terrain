# =============================================================================
# Video-to-3D (V3D) — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in real values. .env is gitignored and must
# NEVER be committed to version control.
#
#   cp .env.example .env
#
# =============================================================================

# =============================================================================
# 1. API KEYS & LLM/VLM PROVIDERS
# =============================================================================

# NVIDIA NIM / build.nvidia.com API keys
# Get keys from https://build.nvidia.com (format: nvapi-...)
# Multiple keys form a rotation pool used when hitting 429 rate limits.
NVIDIA_API_KEY=nvapi-YOUR_NVIDIA_API_KEY_HERE
NVIDIA_API_KEY_1=nvapi-YOUR_NVIDIA_API_KEY_1_HERE
NVIDIA_API_KEY_2=nvapi-YOUR_NVIDIA_API_KEY_2_HERE
NVIDIA_API_KEY_3=nvapi-YOUR_NVIDIA_API_KEY_3_HERE
NVIDIA_API_KEY_4=nvapi-YOUR_NVIDIA_API_KEY_4_HERE
NVIDIA_API_KEY_5=nvapi-YOUR_NVIDIA_API_KEY_5_HERE
NVIDIA_API_KEY_6=nvapi-YOUR_NVIDIA_API_KEY_6_HERE

# NVIDIA NIM endpoints & default model
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VLM_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1

# Groq API (fast LLM/VLM inference)
# Get key from https://console.groq.com
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE

# Tavily API (web search, retrieval, agent tools)
# Get key from https://app.tavily.com
TAVILY_API_KEY=tvly-YOUR_TAVILY_API_KEY_HERE

# Alternative VLM backends (optional, if not using NVIDIA NIM)
# VLM_PROVIDER=nvidia # options: nvidia | groq | openai | anthropic
# OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY_HERE
# ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_API_KEY_HERE

# =============================================================================
# 2. HUGGING FACE & KAGGLE REMOTE EXECUTION
# =============================================================================

# Hugging Face User Access Token (for gated model weights, e.g. Depth-Anything-3)
# Get token from https://huggingface.co/settings/tokens
HF_TOKEN=hf_YOUR_HUGGINGFACE_TOKEN_HERE

# Kaggle credentials (for automated kernel deployment and dataset pushing)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Kaggle Jupyter proxy URLs (obtained from Kaggle notebook -> ⋮ More settings -> Kaggle Jupyter Server)
# Path contains a session JWT token with expiration.
KAGGLE_PROXY_URL=https://kkb-production.jupyter-proxy.kaggle.net/k/SESSION_ID/JWT_TOKEN/proxy
KAGGLE_WITHOUT_INTERNET=https://kkb-production.jupyter-proxy.kaggle.net/k/SESSION_ID/JWT_TOKEN/proxy
KAGGLE_HAS_INTERNET=https://kkb-production.jupyter-proxy.kaggle.net/k/SESSION_ID/JWT_TOKEN/proxy
KAGGLE_PROXY_RTX6000_NO_INTERNET=https://kkb-production.jupyter-proxy.kaggle.net/k/SESSION_ID/JWT_TOKEN/proxy
KAGGLE_PROXY_HAS_INTERNET_NO_GPU=https://kkb-production.jupyter-proxy.kaggle.net/k/SESSION_ID/JWT_TOKEN/proxy

# =============================================================================
# 3. REMOTE GPU SERVER & DEPLOYMENT
# =============================================================================

# SSH credentials for remote GPU server deployment (scripts/deploy/deploy_gpu.py)
SERVER_HOST=10.0.0.1
SERVER_USER=username
SERVER_PASSWORD=your_secure_server_password
SERVER_PORT=22
REMOTE_PROJECT_DIR=/home/username/Video-to-3D

# =============================================================================
# 4. ROBOT SIMULATION & POLICY EXECUTION (Stage I / MuJoCo)
# =============================================================================

# Path to robot model directory (e.g. humanoid robot definitions)
ROOM_ROBOT_DIR=/path/to/robot_assets
ROOM_ROBOT=/path/to/robot_assets

# Path to exported ONNX locomotion/tracking policy
POLICY_PATH=/path/to/exported/policy.onnx
POLICY=/path/to/exported/policy.onnx

# Robot simulation parameters
ROBOT_SPAWN_HEIGHT=1.7
ROBOT_POLICY_TYPE=tracking # options: tracking | velocity
ROBOT_CONFIG=mjlab.assets.robots.generic_biped.biped_constants:get_biped_implicit_actuator_robot_cfg

# =============================================================================
# 5. SEGMENTATION & 3D LIFTING (Stage D2 / F / SAM3)
# =============================================================================

# SAM3 checkpoint path (auto-downloaded from HuggingFace if unset)
# SAM3_CHECKPOINT=/path/to/sam3_checkpoint.pth
SAM3_CONFIDENCE_THRESHOLD=0.6

# =============================================================================
# 6. PIPELINE PATHS & DIRECTORY OVERRIDES (src/v3d/config.py)
# =============================================================================

# Root paths for paper reference, inputs, cache, and intermediate runs
V3D_PAPER_ROOT=/tmp/paper/holi-spatial
V3D_DATA_ROOT=/tmp/data/scannetppv2/data
V3D_WORK_ROOT=/tmp/run
V3D_DELIVER=/tmp/deliver

# Pretrained model weight paths
V3D_DA3_MODEL=/tmp/DA3NESTED-GIANT-LARGE
V3D_VLM_MODEL=/tmp/qwen3vl8b
V3D_SAM3=/kaggle/working/sam3

# Subprocess PYTHONPATH injection
V3D_IMPORT_PATHS=/kaggle/working:/kaggle/working/depth_anything_3:/tmp/nvd/nvd/nvdiffrast

# Scene & resolution tuning
V3D_SCENE=small_factory
V3D_PROCESS_RES=504
V3D_PROCESS_RES_METHOD=upper_bound_resize # upper_bound_resize | lower_bound_resize | upper_bound_crop | lower_bound_crop
V3D_TARGET_POINTS=4000000
V3D_CONF_THRESHOLD=0.3
V3D_MAX_CHUNK_SIZE=800
V3D_SCALE_MODE=assumed # assumed | metric

# =============================================================================
# 7. RENDERING & GRAPHICS HEADLESS BACKENDS
# =============================================================================

# Headless OpenGL / EGL rendering backend (for MuJoCo and visualization)
MUJOCO_GL=egl # egl | osmesa | glfw
PYOPENGL_PLATFORM=egl
EGL_PLATFORM=surfaceless

# =============================================================================
# 8. PRODUCTION & VIDEO INGEST SETTINGS
# =============================================================================

# Maximum frames to process (increase for long video scans)
MAX_FRAMES=100

# Frame sampling rate (1 = process every frame, higher = skip frames)
FRAME_SAMPLE_RATE=5

# Physics validation simulation steps
SIM_STEPS=300
