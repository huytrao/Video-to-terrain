# Video-to-Terrain — environment template
# Copy to .env and fill in real values. .env is gitignored.

# ---- 3 NVIDIA API keys (rotation pool for VLM / DA3 hosted endpoints) ----
NVIDIA_API_KEY_1=nvapi-REPLACE_ME_1
NVIDIA_API_KEY_2=nvapi-REPLACE_ME_2
NVIDIA_API_KEY_3=nvapi-REPLACE_ME_3

# Active alias — points to whichever key is currently in use (rotates on 429).
NVIDIA_API_KEY=${NVIDIA_API_KEY_1}

# NVIDIA NIM / build.nvidia.com endpoint + model (verify on https://build.nvidia.com)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Example VLM model — CONFIRM the exact id on build.nvidia.com before use
NVIDIA_VLM_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1

# ---- Holi-Spatial (Stage D) ----
# If using OpenAI/Anthropic/etc. as the VLM backend instead of NVIDIA, set here:
# OPENAI_API_KEY=sk-...
# VLM_PROVIDER=nvidia | openai | anthropic

# ---- Local repo paths (optional, for cross-repo scripts) ----
# DA3_REPO=/Users/traoanhuy/source_code/Full-pipeline-scan-terrain/depth-anything-3
# MJLAB_REPO=/Users/traoanhuy/source_code/vinrobotics_mjlab
