# Video-to-Terrain — environment template
# Copy to .env and fill in real values. .env is gitignored.

# =============================================================================
# NVIDIA API KEYS (CRITICAL FOR PRODUCTION)
# =============================================================================
# Get real keys from https://build.nvidia.com (NIM API) or NGC
# Each key format: nvapi-<long_random_string>
# Keys are rotated automatically on 429 rate limits (max 3 keys in pool)

# ---- 3 NVIDIA API keys (rotation pool for VLM / DA3 hosted endpoints) ----
NVIDIA_API_KEY=<REPLACE_WITH_YOUR_NVIDIA_API_KEY>
NVIDIA_API_KEY_ACCOUNT2=<REPLACE_WITH_YOUR_NVIDIA_API_KEY_ACCOUNT2>
NVIDIA_API_KEY_ACCOUNT3=<REPLACE_WITH_YOUR_NVIDIA_API_KEY_ACCOUNT3>
NVIDIA_API_KEY_ACCOUNT4=<REPLACE_WITH_YOUR_NVIDIA_API_KEY_ACCOUNT4>
NVIDIA_API_KEY_ACCOUNT5=<REPLACE_WITH_YOUR_NVIDIA_API_KEY_ACCOUNT5>
NVIDIA_API_KEY_ACCOUNT6=<REPLACE_WITH_YOUR_NVIDIA_API_KEY_ACCOUNT6>
# Active alias — points to whichever key is currently in use (rotates on 429).
NVIDIA_API_KEY=${NVIDIA_API_KEY_1}

# NVIDIA NIM / build.nvidia.com endpoint + model
# Verify exact model IDs at https://build.nvidia.com before use
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VLM_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1

# =============================================================================
# OPTIONAL: Alternative VLM providers (set if not using NVIDIA)
# =============================================================================
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# VLM_PROVIDER=nvidia | openai | anthropic  (defaults to nvidia)

# =============================================================================
# HOLI-SPATIAL / SAM3 (Stage D2)
# =============================================================================
# SAM3 model: auto-downloaded from HuggingFace on first run
# Set SAM3_CHECKPOINT to use a local path instead of auto-download
# SAM3_CHECKPOINT=/path/to/sam3_checkpoint.pth

# Confidence threshold for SAM3 masks (0.0-1.0)
SAM3_CONFIDENCE_THRESHOLD=0.6

# =============================================================================
# ROBOT / MJLab (Stage H)
# =============================================================================
# Robot spawn height in meters
ROBOT_SPAWN_HEIGHT=1.7

# Policy type: "tracking" (motion tracking on flat terrain) or "velocity" (locomotion)
ROBOT_POLICY_TYPE=tracking

# MJLab robot config (import path to vinrobotics_mjlab robot constants)
VR_M3_1_ROBOT_CONFIG=vinrobotics_mjlab.assets.robots.vr_m3_1.vr_m3_1_constants:get_vr_m3_1_implicit_actuator_robot_cfg

# =============================================================================
# LOCAL REPO PATHS (optional, for cross-repo scripts)
# =============================================================================
# DA3_REPO=/Users/traoanhuy/source_code/Full-pipeline-scan-terrain/depth-anything-3
# MJLAB_REPO=/Users/traoanhuy/source_code/vinrobotics_mjlab

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================
# Maximum frames to process (increase for production)
MAX_FRAMES=100

# Frame sampling rate (1 = every frame, higher = fewer frames)
FRAME_SAMPLE_RATE=5

# Validation simulation steps
SIM_STEPS=300

# =============================================================================
# INSTRUCTIONS FOR PRODUCTION
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Get NVIDIA API keys from https://build.nvidia.com
#    - Sign in with NVIDIA account
#    - Create API keys (NIM endpoints)
#    - Each key allows ~1000 req/min; use 3 keys for rotation
# 3. Replace ALL placeholder values (nvapi-REPLACE_WITH_REAL_KEY_X)
# 4. Run production setup: python -m src.v2t.setup_production
# 5. Verify: python -m src.v2t.run_pipeline --validate-config
GROQ_API_KEY=<REPLACE_WITH_YOUR_GROQ_API_KEY>
