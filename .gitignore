# Secrets — NEVER commit
.env
.env.*
!.env.example
.backup/
# holds a plaintext Kaggle API key
kaggle_upload_example.py
**/kaggle.json
# the Kaggle Jupyter proxy URL's path *is* a ~400-char JWT, so this file is a
# credential with an expiry, not configuration. Live URLs belong in .env
# (KAGGLE_WITHOUT_INTERNET / KAGGLE_HAS_INTERNET); this is the local fallback.
server-connect.txt

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ClaudeKit / Claude local
.claude/local/

# Pipeline outputs (heavy artifacts)
outputs/
outputs-*/
*.ply
*.npy
# keep scene_mesh/point_cloud only if under tracked samples/

# macOS
.DS_Store

# Node
node_modules/

# Logs. MuJoCo writes MUJOCO_LOG.TXT next to wherever it is invoked, and the
# capitalised .TXT means *.log does not catch it.
*.log
MUJOCO_LOG.TXT

# Input scans and benchmark deliverables: hundreds of MB to several GB of media
# that is produced or downloaded, not authored. input/ keeps its README and
# download script so a fresh clone knows how to refill it.
input/*
!input/README_DOWNLOAD.md
!input/download.sh

# Build artefacts from `pip install -e .`
build/
dist/
*.egg-info/

# depth-anything-3 vendored repo: only ship the installable package
# (src/, pyproject.toml, requirements.txt) - these are gradio demo /
# docs / media cruft, not needed for `pip install -e depth-anything-3`
# and dominate the repo size (~2GB, mostly a nested venv + assets).
depth-anything-3/depth-anything-3-space/
depth-anything-3/assets/
depth-anything-3/reference/
depth-anything-3/notebooks/
depth-anything-3/.venv/
depth-anything-3/__pycache__/

# Kaggle proxy URL cache (short-lived, machine-specific)
.kaggle_proxy_url_cache

# The Kaggle transfer toolkit is a separate git checkout of
# github.com/huytrao/kaggle-runtime-toolkit-agent-skills. Committing the directory
# here would store a *gitlink*, so a fresh clone would get an empty folder and the
# local fix to kaggle_executor.py would silently vanish -- which is the class of
# invisible failure that fix exists to prevent. It is ignored here instead, and the
# local modification is kept as scripts/patches/*.patch until it lands upstream.
kaggle-runtime-toolkit-agent-skills/
# source-reference/ holds the paper checkouts (holi-spatial, Depth-Anything-3) and
# the 15 MB PDF: ~116 MB of upstream code that is fetched, not authored here.
source-reference/

# Collected visual output — regenerate with `make visualize`
/visualize/

# Delivered artefacts: 127 MB of GLB and video, regenerated from the pipeline and
# mirrored to Kaggle. The report's own page is tracked so the writeup survives;
# the media it points at is not.
/output/*
!/output/REPORT/
/output/REPORT/*
!/output/REPORT/index.html
!/output/REPORT/carve_manifest.json
